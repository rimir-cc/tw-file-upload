title: $:/plugins/rimir/file-upload/templates/media-grid
type: text/vnd.tiddlywiki

\whitespace trim

<!--
Reusable attachment-grid components. Consumers transclude this template
and invoke `<<fu-render-media-grid "<filter>">>`.

Opt-in extras (set as <$let> variables in the calling scope):

  fu-draggable        "yes" → each tile wraps in <$draggable> for drag-out.
                      Anything else → plain <div>. Default landscape cell.

  fu-delete-mode      "remove" → tile delete-button fires
                          $action-listops -[<att>] on <<fu-delete-group>>
                          (used by media-group views — removes membership,
                          keeps the underlying file)
                      "none"  → no delete button shown
                      anything else (default) → tm-delete-tiddler so
                          file-upload's confirm-cascade modal catches it

  fu-delete-group     Target tiddler for the remove-mode listops call.
                      Only consulted when fu-delete-mode="remove".

Extension hook:

  \procedure fu-att-extra-actions()  — default no-op. Callers redefining
  this procedure get its rendering appended below the action row in
  every tile. Receives <att> in scope. Used by priv-app to render
  media-group breadcrumb badges on each tile.

EXIF-portrait sizing for the image section is always on; reads
`exif-width` / `exif-height` / `exif-orientation` and applies the
`.fu-att-item-portrait` CSS class when the photo is taller than wide
(accounting for the four 90°-rotated EXIF orientation values 5/6/7/8).
Gracefully no-ops when the EXIF fields aren't set.
-->

\function fu-att-email-artifact(att) [<att>get[type]match[application/vnd.ms-outlook]then<att>addsuffix[.email]] ~[<att>get[type]match[message/rfc822]then<att>addsuffix[.email]]

\function fu-att-label(att) [function[fu-att-email-artifact],<att>] :map[get[msg-subject]] :filter[!is[blank]] ~[<att>get[title]split[/]last[]]

\function fu-att-newtab-href(att) [function[fu-att-email-artifact],<att>] :map[encodeuricomponent[]addprefix[#]] ~[<att>get[_canonical_uri]]

\procedure fu-att-extra-actions()
\end

\procedure fu-att-delete-button()
<%if [<fu-delete-mode>match[remove]] %>
<$button class="tc-btn-invisible fu-att-action-btn fu-att-delete-btn" tooltip="Remove from group">
<$action-listops $tiddler=<<fu-delete-group>> $field="members" $subfilter="-[<att>]"/>
🗑
</$button>
<%elseif [<fu-delete-mode>match[none]] %>
<%else%>
<$button class="tc-btn-invisible fu-att-action-btn fu-att-delete-btn" tooltip="Delete">
<$action-sendmessage $message="tm-delete-tiddler" $param=<<att>>/>
🗑
</$button>
<%endif%>
\end

\procedure fu-att-actions()
<div class="fu-att-info">
<span class="fu-att-name" title={{{ [<att>get[title]split[/]last[]] }}}><$text text={{{ [function[fu-att-label],<att>] }}}/></span>
<$button class="tc-btn-invisible fu-att-action-btn" tooltip="Copy file link">
<$action-sendmessage $message="tm-copy-to-clipboard" $param={{{ [<att>get[_canonical_uri]] }}}/>
📋
</$button>
<a class="tc-btn-invisible fu-att-action-btn fu-att-newtab-link" href={{{ [function[fu-att-newtab-href],<att>] }}} target="_blank" rel="noopener" title="Open in new tab">↗</a>
<<fu-att-delete-button>>
</div>
<$let descState={{{ [<att>addprefix[$:/state/rimir/file-upload/att-desc/]] }}}>
<%if [<descState>get[text]match[edit]] %>
<div class="fu-att-desc-popup-anchor">
<div class="fu-att-desc-popup">
<$edit-text tiddler=<<att>> field="description" tag="textarea" placeholder="Add description..." class="fu-att-desc-textarea" focus="true"/>
<$button class="fu-att-desc-done-btn" set=<<descState>> setTo="">Done</$button>
</div>
</div>
<%elseif [<att>has[description]] %>
<div class="fu-att-desc">
<span class="fu-att-desc-text"><$text text={{{ [<att>get[description]] }}}/></span>
<$button class="tc-btn-invisible fu-att-desc-edit-btn" set=<<descState>> setTo="edit" tooltip="Edit description">✏️</$button>
</div>
<%else%>
<$button class="tc-btn-invisible fu-att-add-desc-btn" set=<<descState>> setTo="edit">+ desc</$button>
<%endif%>
</$let>
\end

\procedure fu-tile-click-actions()
<$action-setfield $tiddler="$:/state/rimir/file-upload/media-modal" text=<<att>>/>
\end

\procedure fu-att-tile-img-body()
<div class="fu-att-thumb">
<$button class="tc-btn-invisible fu-att-thumb-nav" actions=<<fu-tile-click-actions>>>
<img draggable="false" loading="lazy" src=<<imgSrc>>/>
<%if [<showPlayBadge>match[yes]] %>
<div class="fu-att-play-badge">&#9654;</div>
<%endif%>
</$button>
</div>
<<fu-att-actions>>
<<fu-att-extra-actions>>
\end

<!-- NB: no parameters. `<<imgSrc>>`, `<<showPlayBadge>>`, `<<itemCls>>` and
     `<<att>>` are read from the caller's `<$let>` / `<$list>` scope via
     procedure-scope inheritance. Positional-arg passing for procedures
     like `<<myproc {{{[<var>]}}}>>` is unreliable — TW's macro-call arg
     parser treats `{{{...}}}` as a literal bareword, NOT as a transclude
     that resolves at call site (see tw-procedure-call-passes-literal
     memory). For values that aren't compile-time constants, use $let
     binding in the caller scope instead. -->
\procedure fu-att-tile-img()
<%if [<fu-draggable>match[yes]] %>
<$draggable tiddler=<<att>> class=<<itemCls>>>
<<fu-att-tile-img-body>>
</$draggable>
<%else%>
<div class=<<itemCls>>>
<<fu-att-tile-img-body>>
</div>
<%endif%>
\end

\procedure fu-att-tile-file-body()
<$button class="tc-btn-invisible fu-att-file-link" actions=<<fu-tile-click-actions>>>
📄 <$text text={{{ [function[fu-att-label],<att>] }}}/>
</$button>
<$button class="tc-btn-invisible fu-att-action-btn" tooltip="Copy file link">
<$action-sendmessage $message="tm-copy-to-clipboard" $param={{{ [<att>get[_canonical_uri]] }}}/>
📋
</$button>
<a class="tc-btn-invisible fu-att-action-btn fu-att-newtab-link" href={{{ [function[fu-att-newtab-href],<att>] }}} target="_blank" rel="noopener" title="Open in new tab">↗</a>
<<fu-att-delete-button>>
<<fu-att-extra-actions>>
\end

\procedure fu-att-tile-file()
<%if [<fu-draggable>match[yes]] %>
<$draggable tiddler=<<att>> class="fu-att-file-row">
<<fu-att-tile-file-body>>
</$draggable>
<%else%>
<div class="fu-att-file-row">
<<fu-att-tile-file-body>>
</div>
<%endif%>
\end

\procedure fu-render-media-grid(itemFilter)
<!-- Inline navigator: appify replaces the page-level navigator, so without
     this wrap `tm-delete-tiddler` dispatched from the tile delete button
     would silently no-op (see tw-appify-no-navigator memory). file-upload's
     delete-confirm.js monkey-patches `handleDeleteTiddlerEvent` on the
     navigator class — the patch only runs when a navigator catches the
     message. Dedicated state tiddlers keep this nav out of the global
     story; sibling navigators with shared state are safe because we never
     push to the story (no tm-navigate calls inside the grid). -->
<$navigator story="$:/state/rimir/file-upload/media-grid/story" history="$:/state/rimir/file-upload/media-grid/history">
<div class="fu-att-grid">
<!-- 1. Thumbnailed non-image, non-video (PDFs, .msg, docx with generated thumb) -->
<$list filter="[subfilter<itemFilter>has[_thumbnail_uri]] :filter[get[type]!prefix[image/]!prefix[video/]]" variable="att">
<$let imgSrc={{{ [<att>get[_thumbnail_uri]] }}} itemCls="fu-att-item">
<<fu-att-tile-img>>
</$let>
</$list>
<!-- 2. Video thumbnails (with play badge) -->
<$list filter="[subfilter<itemFilter>has[_thumbnail_uri]] :filter[get[type]prefix[video/]]" variable="att">
<$let imgSrc={{{ [<att>get[_thumbnail_uri]] }}} itemCls="fu-att-item" showPlayBadge="yes">
<<fu-att-tile-img>>
</$let>
</$list>
<!-- 3. Images (with or without thumb — fall back to canonical URI). EXIF-portrait
     sizing always-on: detects rotated-90° EXIF orientations (5/6/7/8) and the
     ratio of width:height, applies fu-att-item-portrait class when appropriate. -->
<$list filter="[subfilter<itemFilter>] :filter[get[type]prefix[image/]]" variable="att">
<$let
  thumbUri={{{ [<att>get[_thumbnail_uri]] }}}
  fullUri={{{ [<att>get[_canonical_uri]] }}}
  imgSrc={{{ [<thumbUri>!is[blank]then<thumbUri>] ~[<fullUri>] }}}
  exifW={{{ [<att>get[exif-width]] }}}
  exifH={{{ [<att>get[exif-height]] }}}
  exifO={{{ [<att>get[exif-orientation]] }}}
  rotated={{{ [[5 6 7 8]split[ ]] :filter[<currentTiddler>match<exifO>] +[limit[1]] }}}
  isPortrait={{{ [<rotated>!is[blank]] :filter[<exifW>compare:number:gt<exifH>] ~[<exifH>compare:number:gt<exifW>] }}}
  itemCls={{{ [<isPortrait>!is[blank]then[fu-att-item fu-att-item-portrait]] ~[[fu-att-item]] }}}
>
<<fu-att-tile-img>>
</$let>
</$list>
</div>
<!-- 4. Plain file list (no thumbnail + not an image) -->
<$list filter="[subfilter<itemFilter>!has[_thumbnail_uri]] :filter[get[type]!prefix[image/]]" variable="att">
<<fu-att-tile-file>>
</$list>
</$navigator>
\end
