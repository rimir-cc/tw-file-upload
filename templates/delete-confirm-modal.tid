title: $:/plugins/rimir/file-upload/templates/delete-confirm-modal
subtitle: Delete uploaded file?
footer: <$let target={{{ [{$:/state/rimir/file-upload/delete-confirm/cascade}jsonget[target]] }}}><$button message="tm-close-tiddler">Cancel</$button> <$button class="rr-danger-btn"><$action-deletetiddler $tiddler=<<target>>/><$action-deletetiddler $tiddler="$:/state/rimir/file-upload/delete-confirm/cascade"/><$action-sendmessage $message="tm-close-tiddler"/>Delete anyway</$button></$let>

\function fu.state.tiddler() [[$:/state/rimir/file-upload/delete-confirm/cascade]]
\function fu.state.json() [{$:/state/rimir/file-upload/delete-confirm/cascade}jsonget[]]
\function fu.target() [{$:/state/rimir/file-upload/delete-confirm/cascade}jsonget[target]]
\function fu.cascade() [{$:/state/rimir/file-upload/delete-confirm/cascade}jsonindexes[cascade]] :map[{$:/state/rimir/file-upload/delete-confirm/cascade}jsonget[cascade],<currentTiddler>]
\function fu.backlinks() [{$:/state/rimir/file-upload/delete-confirm/cascade}jsonindexes[backlinks]] :map[{$:/state/rimir/file-upload/delete-confirm/cascade}jsonget[backlinks],<currentTiddler>]
\function fu.derivedHint() [{$:/state/rimir/file-upload/delete-confirm/cascade}jsonget[derivedHint]]

<style scoped>
.rr-delete-confirm { font-size: 0.9em; }
.rr-delete-confirm h3 { margin: 0.4em 0 0.2em; }
.rr-delete-confirm ul { margin: 0.2em 0 0.6em 1.2em; padding: 0; }
.rr-delete-confirm li { margin: 0.1em 0; word-break: break-all; }
.rr-delete-confirm .rr-derived-hint { font-family: monospace; font-size: 0.85em; opacity: 0.8; }
.rr-delete-confirm .rr-backlinks-warn { color: #b35900; }
</style>

<div class="rr-delete-confirm">

<$let target={{{ [function[fu.target]] }}}>

Delete "<$text text=<<target>>/>" ?

<$list filter="[function[fu.cascade]first[]]" emptyMessage="//No additional artifacts depend on this tiddler.//">

''This will also remove:''

<ul>
<$list filter="[function[fu.cascade]]" variable="art">
<li><$text text=<<art>>/></li>
</$list>
</ul>
</$list>

<$list filter="[function[fu.derivedHint]!is[blank]]" variable="hint">
<div class="rr-derived-hint">…and any files under <$text text=<<hint>>/></div>
</$list>

<$list filter="[function[fu.backlinks]first[]]">

<div class="rr-backlinks-warn">

⚠️ ''Referenced from <$count filter="[function[fu.backlinks]]"/> other tiddler(s):''

<ul>
<$list filter="[function[fu.backlinks]limit[20]]" variable="bl">
<li><$link to=<<bl>>><$text text=<<bl>>/></$link></li>
</$list>
<$list filter="[function[fu.backlinks]count[]subtract[20]compare:integer:gt[0]then[yes]]">
<li>…and <$count filter="[function[fu.backlinks]]"/>−20 more</li>
</$list>
</ul>

These references will break if you proceed.
</div>
</$list>

</$let>

</div>
